exports[`the shell builds the same shell for a gallery whose content click does not close 1`] = `
"<div class="brz-lb-wrap brz-lb-gallery brz-lb-close-btn-in brz-lb-auto-cursor" tabindex="-1" style="overflow: auto; overflow-x: hidden; overflow-y: auto;">
<div class="brz-lb-container brz-lb-s-loading brz-lb-image-holder">
<div class="brz-lb-content">
<div class="brz-lb-figure brz-lb-loading">
<button title="Close (Esc)" type="button" class="brz-lb-close">×</button>
<figure>
<img class="brz-lb-img" alt="A" src="/a.jpg" style="max-height: 800px;">
<figcaption>
<div class="brz-lb-bottom-bar">
<div class="brz-lb-title">A</div>
<div class="brz-lb-counter">1 of 3</div>
</div>
</figcaption>
</figure>
</div>
</div>
<div class="brz-lb-preloader">Loading...</div>
<button title="Previous (Left arrow key)" type="button" class="brz-lb-arrow brz-lb-arrow-left brz-lb-prevent-close">
</button>
<button title="Next (Right arrow key)" type="button" class="brz-lb-arrow brz-lb-arrow-right brz-lb-prevent-close">
</button>
</div>
</div>"
`;

